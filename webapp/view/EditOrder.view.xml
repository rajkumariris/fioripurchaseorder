<mvc:View
    controllerName="demo.controller.EditOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:fs="sap.f"
>
    <m:Page
        title="Order Details"
        showNavButton="true"
    >
        <m:content>
            <fs:Card>
                <fs:content>
                    <m:Panel>
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Deal Header" />
                                <ToolbarSpacer />
                            </OverflowToolbar>
                        </headerToolbar>
                        <m:content>
                            <VBox>
                                <f:Form editable="true">
                                    <f:layout>
                                        <f:ColumnLayout
                                            columnsL="2"
                                            columnsM="1"
                                            columnsXL="3"
                                            labelCellsLarge="3"
                                        />
                                    </f:layout>
                                    <f:formContainers>
                                        <f:FormContainer>
                                            <f:formElements>
                                                <f:FormElement
                                                    label="Order Number"
                                                    id="orderNumber"
                                                >
                                                    <f:fields>
                                                        <Input
                                                            value="{poDetails>/PurchaseOrder}"
                                                            showValueHelp="true"
                                                            valueHelpRequest="_onPoValueHelpRequest"
                                                            editable="false"
                                                        />
                                                    </f:fields>
                                                </f:FormElement>
                                                <f:FormElement
                                                    label="Company Code"
                                                    id="companycode"
                                                >
                                                    <f:fields>
                                                        <Input
                                                            value="{poDetails>/CompanyCode}"
                                                             showValueHelp="true"
                                                             valueHelpRequest="_onPoValueHelpRequest"
                                                            editable="true"
                                                        />
                                                    </f:fields>
                                                </f:FormElement>
                                                 <f:FormElement
                                                    label="Material"
                                                    id="Material"
                                                >
                                                    <f:fields>
                                                        <Input
                                                            value="{poDetails>/CompanyCode}"
                                                             showValueHelp="true"
                                                             valueHelpRequest="_onPoValueHelpRequest"
                                                            editable="true"
                                                        />
                                                    </f:fields>
                                                </f:FormElement>
                                            </f:formElements>
                                        </f:FormContainer>
                                    </f:formContainers>
                                </f:Form>
                                             <Button
                                    text="Save"
                                    width="75px"
                                    type="Accept"
                                    class="sapUiTinyMarginBegin"
                                    press="onSaveButtonPress"
                              />
                            </VBox>
                        </m:content>
                    </m:Panel>
                </fs:content>
            </fs:Card>
        </m:content>
    </m:Page>
</mvc:View>
